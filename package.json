{
  "name": "dsh-illuminating-skin",
  "version": "0.5.7",
  "description": "IntelliJ IDEA 风格的 DSH 毛玻璃皮肤：左栏与窗口标题栏连成一块玻璃，标题栏中央透出可换色的光，主栏是四周留缝的圆角卡片，设置 / 搜索 / 菜单 / 提示框等浮层统一磨砂。可独立使用（会话标题与视图标签自动放进标题栏），也可搭配 dsh-claude-style（此时只改配色）。外观菜单可切换发光颜色、彩色卡片与深浅色主题。",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "glass",
    "glassmorphism",
    "frosted",
    "frosted-glass",
    "acrylic",
    "translucent",
    "idea",
    "intellij",
    "dark"
  ],
  "license": "GPL-3.0-only",
  "author": "ExTetragon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExTetragon/dsh-illuminating-skin.git"
  },
  "homepage": "https://github.com/ExTetragon/dsh-illuminating-skin#readme",
  "bugs": {
    "url": "https://github.com/ExTetragon/dsh-illuminating-skin/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/client.js && node --check lib/index.js"
  },
  "peerDependencies": {
    "dsh-claude-style": ">=0.19.0"
  },
  "peerDependenciesMeta": {
    "dsh-claude-style": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["theme"],
      "platform": "web"
    }
  }
}
